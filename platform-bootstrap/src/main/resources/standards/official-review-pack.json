      "expression": "[〇零一二三四五六七八九]{4}年[一二三四五六七八九十〇零]{1,3}月",
      "source": "format",
      "clause": "7.3.5.4",
      "types": []
    },
    {
      "code": "STD-ISSUE-YEAR-TWO-DIGIT",
      "name": "发文字号年份不是四位",
