  "rules": [
    {
      "code": "STD-ISSUE-YEAR-BRACKETS",
      "name": "发文字号年份使用六角括号",
      "category": "格式与版式",
      "risk": "一般",
      "method": "正则",
      "expression": "[\\[【（(]([12]\\d{3})[\\]】）)](?=\\d+号)=>〔$1〕",
      "source": "format",
      "clause": "7.2.5",
      "types": []
    },
    {
      "code": "STD-ISSUE-ORDER-LEADING-ZERO",
      "name": "发文顺序号不编虚位",
      "category": "格式与版式",
      "risk": "一般",
      "method": "正则",
      "expression": "〔([12]\\d{3})〕0+([1-9]\\d*)号=>〔$1〕$2号",
      "source": "format",
      "clause": "7.2.5",
      "types": []
    },
    {
      "code": "STD-ISSUE-ORDER-DI",
      "name": "发文顺序号不加第字",
      "category": "格式与版式",
      "risk": "一般",
      "method": "正则",
      "expression": "〔([12]\\d{3})〕第(\\d+)号=>〔$1〕$2号",
      "source": "format",
      "clause": "7.2.5",
      "types": []
    },
    {
      "code": "STD-PUNCT-ELLIPSIS",
      "name": "中文语句中的省略号形式",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "(?<=[\\p{IsHan}])\\.{3,}(?=[\\p{IsHan}，。；：！？])=>……",
      "source": "punctuation",
      "clause": "4.11.2",
      "types": []
    },
    {
      "code": "STD-VARIANT-GF1001",
      "name": "第一批异形词推荐词形提示",
      "category": "语言文字",
      "risk": "提示",
      "method": "词库",
      "expression": "NAT-VARIANT-WORDS-GF1001-2001",
      "source": "variant-words",
      "clause": "正文推荐词形表（338组）",
      "types": []
    },
    {
      "code": "STD-DATE-MONTH-LEADING-ZERO",
      "name": "成文日期月份不编虚位",
      "category": "格式与版式",
      "risk": "一般",
      "method": "正则",
      "expression": "([12]\\d{3}年)0([1-9])月=>$1$2月",
      "source": "format",
      "clause": "7.3.5.4",
      "types": []
    },
    {
      "code": "STD-DATE-DAY-LEADING-ZERO",
      "name": "成文日期日期不编虚位",
      "category": "格式与版式",
      "risk": "一般",
      "method": "正则",
      "expression": "([12]\\d{3}年(?:0?[1-9]|1[0-2])月)0([1-9])日=>$1$2日",
