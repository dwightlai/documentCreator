{
  "code": "CN-OFFICIAL-DOCUMENT-BASE",
  "version": "2026.11.04-1",
  "title": "党政机关公文可执行审校规则包（依据公开规范整理）",
  "scope": "发文字号、成文日期、份号和标点的明确格式检查；GF 1001—2001 正文异形词；公文高频错写、成语误写、现行机关和行政区划错写、非法定单位旧称、专名错字。两可词、历史旧称和已废止法律只提示、不自动替换。",
  "sources": {
    "format": "GB/T 9704—2012《党政机关公文格式》（现行），https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=F3CC9BEF482524C895FDA7A08BB4A70E；标准文本公开页：https://zjjcmspublic.oss-cn-hangzhou-zwynet-d01-a.internet.cloud.zj.gov.cn/jcms_files/jcms1/web3124/site/attach/0/8373ff13032a45a180308bc53c4f75a8.pdf",
    "punctuation": "GB/T 15834—2011《标点符号用法》（现行），https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=22EA6D162E4110E752259661E1A0D0A8；标准文本公开页：https://www.zhangye.gov.cn/szb/dzdt/zsbx/201811/t20181129_138125_ghb.html",
    "variant-words": "GF 1001—2001《第一批异形词整理表》（推荐性试行规范），https://www.moe.gov.cn/jyb_sjzl/ziliao/A19/201001/t20100115_75687.html；标准文本：https://www.moe.gov.cn/ewebeditor/uploadfile/2015/01/12/20150112165927212.pdf",
    "numerals": "GB/T 15835—2011《出版物上数字用法》（现行），https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=F5DAC3377DA99C8D78AE66735B6359C7",
    "ordinance": "《党政机关公文处理工作条例》（中办发〔2012〕14号），https://rsj.panjin.gov.cn/2020_07/23_16/content-280059.html",
    "civil-code": "《中华人民共和国民法典》第1260条（2021年1月1日起施行，同时废止婚姻法、继承法、民法通则、收养法、担保法、合同法、物权法、侵权责任法、民法总则）。国家法律法规数据库：https://flk.npc.gov.cn/",
    "agencies": "《国务院关于机构设置的通知》（国发〔2023〕5号），https://app.www.gov.cn/govdata/gov/202303/20/498124/article.html",
    "divisions": "现行行政区划全称。民政部全国行政区划信息：https://www.mca.gov.cn/",
    "units": "《中华人民共和国计量法》及国务院《关于在我国统一实行法定计量单位的命令》（1984年）。只收录与法定单位同义的旧称，不收录公斤、公里、亩。",
    "confusable": "公文高频错写中字形可以判定的推荐写法。不是国家标准词表，也不是商业词库复制。权利/权力、截止/截至、制定/制订、反应/反映等两可词不收录，不自动替换。",
    "idiom": "成语和固定词组的通行写法。只收录字形或语序可以判定的误写；语义易误用但字形正确的条目不收录。",
    "proper": "领导人姓名和固定表述中可以判定的错字。只提示字形，不评价政策内容。"
  },
