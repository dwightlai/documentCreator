  "rules": [
    {
      "code": "STD-ISSUE-YEAR-BRACKETS",
      "name": "发文字号年份使用六角括号",
      "category": "格式与版式",
      "risk": "一般",
      "method": "正则",
      "expression": "[\\[【（(]([12]\\d{3})[\\]】）)](?=\\d+号)=>〔$1〕",
      "source": "format",
      "clause": "7.2.5",
      "types": []
    },
    {
      "code": "STD-ISSUE-ORDER-LEADING-ZERO",
      "name": "发文顺序号不编虚位",
      "category": "格式与版式",
      "risk": "一般",
      "method": "正则",
      "expression": "〔([12]\\d{3})〕0+([1-9]\\d*)号=>〔$1〕$2号",
      "source": "format",
      "clause": "7.2.5",
      "types": []
    },
    {
      "code": "STD-ISSUE-ORDER-DI",
      "name": "发文顺序号不加第字",
      "category": "格式与版式",
      "risk": "一般",
      "method": "正则",
      "expression": "〔([12]\\d{3})〕第(\\d+)号=>〔$1〕$2号",
      "source": "format",
      "clause": "7.2.5",
      "types": []
    },
    {
      "code": "STD-PUNCT-ELLIPSIS",
      "name": "中文语句中的省略号形式",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "(?<=[\\p{IsHan}])\\.{3,}(?=[\\p{IsHan}，。；：！？])=>……",
      "source": "punctuation",
      "clause": "4.11.2",
      "types": []
    },
    {
      "code": "STD-VARIANT-GF1001",
      "name": "第一批异形词推荐词形提示",
      "category": "语言文字",
      "risk": "提示",
      "method": "词库",
      "expression": "NAT-VARIANT-WORDS-GF1001-2001",
      "source": "variant-words",
      "clause": "正文推荐词形表（338组）",
      "types": []
    },
    {
      "code": "STD-DATE-MONTH-LEADING-ZERO",
      "name": "成文日期月份不编虚位",
      "category": "格式与版式",
      "risk": "一般",
      "method": "正则",
      "expression": "([12]\\d{3}年)0([1-9])月=>$1$2月",
      "source": "format",
      "clause": "7.3.5.4",
      "types": []
    },
    {
      "code": "STD-DATE-DAY-LEADING-ZERO",
      "name": "成文日期日期不编虚位",
      "category": "格式与版式",
      "risk": "一般",
      "method": "正则",
      "expression": "([12]\\d{3}年(?:0?[1-9]|1[0-2])月)0([1-9])日=>$1$2日",
      "source": "format",
      "clause": "7.3.5.4",
      "types": []
    },
    {
      "code": "STD-PUNCT-REPEATED-COMMA",
      "name": "连续重复逗号提示",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "，{2,}=>，",
      "source": "punctuation",
      "clause": "第4章：逗号用法",
      "types": []
    },
    {
      "code": "STD-PUNCT-REPEATED-PERIOD",
      "name": "连续重复句号提示",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "。{2,}=>。",
      "source": "punctuation",
      "clause": "第4章：句号用法",
      "types": []
    },
    {
      "code": "STD-PUNCT-ELLIPSIS-REDUNDANT-WORD",
      "name": "省略号与等类词语并用",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "……(?:等(?:等)?|什么的)",
      "source": "punctuation",
      "clause": "A.9.2",
      "types": []
    },
    {
      "code": "STD-PUNCT-ELLIPSIS-OVERLONG",
      "name": "连续使用超过两个省略号",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "(?:……){3,}",
      "source": "punctuation",
      "clause": "A.9.1",
      "types": []
    },
    {
      "code": "STD-PUNCT-ASCII-COMMA-BETWEEN-HAN",
      "name": "汉字之间使用半角逗号",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "(?<=[\\p{IsHan}]),(?=[\\p{IsHan}])=>，",
      "source": "punctuation",
      "clause": "4.4.2",
      "types": []
    },
    {
      "code": "STD-PUNCT-ASCII-COLON-BETWEEN-HAN",
      "name": "汉字之间使用半角冒号",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "(?<=[\\p{IsHan}]):(?=[\\p{IsHan}])=>：",
      "source": "punctuation",
      "clause": "4.7.2",
      "types": []
    },
    {
      "code": "STD-PUNCT-ASCII-SEMICOLON",
      "name": "汉字之间使用半角分号",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "(?<=[\\p{IsHan}]);(?=[\\p{IsHan}])=>；",
      "source": "punctuation",
      "clause": "4.6 分号",
      "types": []
    },
    {
      "code": "STD-PUNCT-ASCII-QUESTION",
      "name": "汉字之间使用半角问号",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "(?<=[\\p{IsHan}])\\?(?=[\\p{IsHan}])=>？",
      "source": "punctuation",
      "clause": "4.8 问号",
      "types": []
    },
    {
      "code": "STD-PUNCT-ASCII-EXCLAMATION",
      "name": "汉字之间使用半角叹号",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "(?<=[\\p{IsHan}])!(?=[\\p{IsHan}])=>！",
      "source": "punctuation",
      "clause": "4.7 叹号",
      "types": []
    },
    {
      "code": "STD-PUNCT-ASCII-DOT-BETWEEN-HAN",
      "name": "汉字之间使用半角句点",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "(?<=[\\p{IsHan}])\\.(?=[\\p{IsHan}])",
      "source": "punctuation",
      "clause": "4.2 句号；间隔号另见",
      "types": []
    },
    {
      "code": "STD-PUNCT-ASCII-PARENS",
      "name": "汉字之间使用半角括号",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "(?<=[\\p{IsHan}])\\(([^()\\n]{1,40})\\)(?=[\\p{IsHan}])=>（$1）",
      "source": "punctuation",
      "clause": "4.9 括号",
      "types": []
    },
    {
      "code": "STD-PUNCT-ASCII-QUOTES",
      "name": "汉字之间使用半角引号",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "(?<=[\\p{IsHan}])\\\"([^\\\"\\n]{1,40})\\\"(?=[\\p{IsHan}])=>“$1”",
      "source": "punctuation",
      "clause": "4.11 引号",
      "types": []
    },
    {
      "code": "STD-PUNCT-REPEATED-EXCLAMATION",
      "name": "叹号重复",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "！{2,}=>！",
      "source": "punctuation",
      "clause": "4.7 叹号",
      "types": []
    },
    {
      "code": "STD-PUNCT-REPEATED-QUESTION",
      "name": "问号重复",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "？{2,}=>？",
      "source": "punctuation",
      "clause": "4.8 问号",
      "types": []
    },
    {
      "code": "STD-PUNCT-REPEATED-DUNHAO",
      "name": "顿号重复",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "、{2,}=>、",
      "source": "punctuation",
      "clause": "4.5 顿号",
      "types": []
    },
    {
      "code": "STD-PUNCT-SPACE-BEFORE",
      "name": "中文标点前有空格",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "([ \\t]+)([，。；：、！？])=>$2",
      "source": "punctuation",
      "clause": "标点与文字之间不留空格",
      "types": []
    },
    {
      "code": "STD-PUNCT-HAN-HYPHEN",
      "name": "汉字之间用连字符代替破折号",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "(?<=[\\p{IsHan}])--(?=[\\p{IsHan}])=>——",
      "source": "punctuation",
      "clause": "4.10 破折号",
      "types": []
    },
    {
      "code": "STD-PUNCT-YEAR-RANGE",
      "name": "年份起止用连字符",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "((?:19|20)\\d{2})-{1,2}((?:19|20)\\d{2})(?=年)=>$1—$2",
      "source": "numerals",
      "clause": "连接号",
      "types": []
    },
    {
      "code": "STD-PUNCT-BOOK-TITLE-ANGLE",
      "name": "书名号误用单角括号",
      "category": "语言文字",
      "risk": "提示",
      "method": "正则",
      "expression": "〈([^〈〉\\n]{1,40})〉=>《$1》",
      "source": "punctuation",
      "clause": "4.15 书名号",
      "types": []
    },
    {
      "code": "STD-NUM-YEAR-THOUSANDS",
      "name": "年份使用千分位",
      "category": "格式与版式",
      "risk": "一般",
      "method": "正则",
      "expression": "(?<!\\d)([12]),(\\d{3})(?=年)=>$1$2",
      "source": "numerals",
      "clause": "年份用阿拉伯数字，不使用千分位",
      "types": []
    },
    {
      "code": "STD-DATE-DOTTED",
      "name": "日期使用点号分隔",
      "category": "格式与版式",
      "risk": "一般",
      "method": "正则",
      "expression": "(?<!\\d)((?:19|20)\\d{2})\\.(0?)([1-9]|1[0-2])\\.(0?)([1-9]|[12]\\d|3[01])(?!\\d)=>$1年$3月$5日",
      "source": "format",
      "clause": "7.3.5.4",
      "types": []
    },
    {
      "code": "STD-DATE-CHINESE-NUMERAL",
      "name": "成文日期使用汉字数字",
      "category": "格式与版式",
      "risk": "提示",
