POSTGRES_DB=document_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-this-database-password
REDIS_PASSWORD=change-this-redis-password
MINIO_ROOT_USER=platform-minio
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET=document-platform
MINIO_ACCESS_KEY=document-platform-app
MINIO_SECRET_KEY=change-this-minio-application-password
MODEL_ALLOWED_ENDPOINTS=https://model-gateway.example.gov.cn/v1/chat/completions
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-oidc-admin-password
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-this-keycloak-database-password
PLATFORM_WEB_PORT=8088
PLATFORM_PUBLIC_URL=http://localhost:8088
PLATFORM_ALLOWED_ORIGINS=http://localhost:8088
OA_CALLBACK_ALLOWLIST=https://oa.example.gov.cn/callback/review/
OA_SHARED_SECRET=replace-with-secret-manager-value
OA_CALLBACK_TIMEOUT=10s
PLATFORM_FILE_STORAGE_ROOT=/app/data/files
OIDC_PUBLIC_URL=http://localhost:8180
OIDC_REALM=document-platform
OIDC_CLIENT_ID=document-platform-web
JAVA_OPTS=-XX:MaxRAMPercentage=75 -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
